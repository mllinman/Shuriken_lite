# CyberRanger E-commerce Environment Configuration
# Copy this to .env and update with your actual values

# Database
DB_FILE=shuriken_hub.db

# JWT Secret
JWT_SECRET=cyberranger_security_jwt_secret_key_change_in_production

# Stripe Configuration (Test Mode)
STRIPE_SECRET_KEY=sk_test_51ABC...your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_51ABC...your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_...your_webhook_secret_here

# Server Configuration
PORT=3000
NODE_ENV=development